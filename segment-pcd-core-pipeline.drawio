<mxfile host="app.diagrams.net" modified="2026-07-21T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="segment-pcd-core" name="Segment point cloud">
    <mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Point-cloud semantic segmentation pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="70" y="35" width="850" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Core transformation from point coordinates and intensity to one semantic label per point" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="70" y="82" width="980" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="prepareLane" value="1. PREPARE THE POINT SET" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;arcSize=8;fillColor=#F0F7FF;swimlaneFillColor=#FAFCFF;strokeColor=#6B9BD2;fontColor=#274C77;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="135" width="2260" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="Point coordinates&lt;br&gt;+&lt;br&gt;point intensity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;fontColor=#1F2937;fontSize=16;fontStyle=1;spacing=8;" vertex="1" parent="prepareLane">
          <mxGeometry x="40" y="75" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="validate" value="Validate correspondence&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;each coordinate row must have one&lt;br&gt;matching intensity value&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="prepareLane">
          <mxGeometry x="410" y="82" width="350" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="empty" value="Any points?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D68910;fontColor=#1F2937;fontSize=14;fontStyle=1;" vertex="1" parent="prepareLane">
          <mxGeometry x="875" y="75" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="emptyOutput" value="Return empty labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C65D4B;fontColor=#1F2937;fontSize=14;" vertex="1" parent="prepareLane">
          <mxGeometry x="875" y="5" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="intensityPrep" value="Optionally normalize intensity&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;disabled in the default configuration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="prepareLane">
          <mxGeometry x="1230" y="92" width="350" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="centerAll" value="Center the complete point set&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;subtract the mean position so processing&lt;br&gt;uses relative rather than absolute coordinates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="prepareLane">
          <mxGeometry x="1710" y="77" width="470" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B8DEF;" edge="1" parent="prepareLane" source="input" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D68910;" edge="1" parent="prepareLane" source="validate" target="empty"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C65D4B;fontColor=#8B3328;fontStyle=1;" edge="1" parent="prepareLane" source="empty" target="emptyOutput"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B8DEF;fontColor=#274C77;fontStyle=1;" edge="1" parent="prepareLane" source="empty" target="intensityPrep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="prepareLane" source="intensityPrep" target="centerAll"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="fragmentLane" value="2. DIVIDE THE POINT SET INTO OVERLAPPING MODEL-SIZED FRAGMENTS" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;arcSize=8;fillColor=#FFF7E6;swimlaneFillColor=#FFFCF5;strokeColor=#D6A84A;fontColor=#5B451D;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="425" width="2260" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="grid" value="Overlay a 3D voxel grid&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;voxel size comes from the trained&lt;br&gt;model configuration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="fragmentLane">
          <mxGeometry x="70" y="88" width="370" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="overlap" value="Generate overlapping fragments&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;overlap gives boundary points another&lt;br&gt;chance to be seen with useful context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="fragmentLane">
          <mxGeometry x="570" y="78" width="400" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="sample" value="Fit each fragment to the model's&lt;br&gt;configured input sample count&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;sampling may repeat source points&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="fragmentLane">
          <mxGeometry x="1100" y="78" width="410" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="mapping" value="Carry source-position mappings&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;every sampled fragment row can later be&lt;br&gt;related back to its originating point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="fragmentLane">
          <mxGeometry x="1650" y="78" width="470" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6A84A;" edge="1" parent="fragmentLane" source="grid" target="overlap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6A84A;" edge="1" parent="fragmentLane" source="overlap" target="sample"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="fragmentLane" source="sample" target="mapping"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="inferenceLane" value="3. PROCESS EVERY FRAGMENT" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;arcSize=8;fillColor=#EDF9F0;swimlaneFillColor=#FBFEFC;strokeColor=#4C9A62;fontColor=#2F6B3C;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="735" width="2260" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="fragment" value="Current fragment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="40" y="90" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="preserve" value="Preserve fragment coordinates&lt;br&gt;for later spatial reconstruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="390" y="90" width="340" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="centerFragment" value="Center coordinates within&lt;br&gt;the current fragment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="820" y="90" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="features" value="Create model features&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;centered X, Y, Z and intensity&lt;br&gt;for every sampled point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="1220" y="78" width="350" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="model" value="Run RandLA-Net inference&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;produce one class-probability vector&lt;br&gt;for every sampled fragment point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDF7;strokeColor=#8E63B0;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="1690" y="70" width="430" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="deduplicate" value="Collapse repeated samples&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;keep one coordinate and one score vector&lt;br&gt;per source point within this fragment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="1160" y="265" width="390" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="accumulate" value="Map back to source positions&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;add class scores and increment how many&lt;br&gt;fragments observed each source point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="inferenceLane">
          <mxGeometry x="610" y="265" width="430" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="i1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="inferenceLane" source="fragment" target="preserve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="inferenceLane" source="preserve" target="centerFragment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="inferenceLane" source="centerFragment" target="features"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E63B0;" edge="1" parent="inferenceLane" source="features" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6A84A;" edge="1" parent="inferenceLane" source="model" target="deduplicate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6A84A;" edge="1" parent="inferenceLane" source="deduplicate" target="accumulate"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mergeLane" value="4. MERGE OVERLAPPING PREDICTIONS" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;arcSize=8;fillColor=#FFF7E6;swimlaneFillColor=#FFFCF5;strokeColor=#D6A84A;fontColor=#5B451D;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="1225" width="2260" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="covered" value="Keep points observed by at least&lt;br&gt;one model fragment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="mergeLane">
          <mxGeometry x="170" y="82" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="average" value="Average each point's accumulated&lt;br&gt;class scores across all observations&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;overlapping fragments now contribute together&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#D6A84A;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="mergeLane">
          <mxGeometry x="770" y="65" width="460" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="references" value="Create spatial reference points&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;each has a coordinate and an averaged&lt;br&gt;class-probability vector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="mergeLane">
          <mxGeometry x="1510" y="65" width="470" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="m1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6A84A;" edge="1" parent="mergeLane" source="covered" target="average"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="mergeLane" source="average" target="references"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="reconstructLane" value="5. RECONSTRUCT A CLASS FOR EVERY INPUT POINT" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;arcSize=8;fillColor=#F4EEFA;swimlaneFillColor=#FCFAFE;strokeColor=#8E63B0;fontColor=#583A72;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="1495" width="2260" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="tree" value="Build a KD-tree from the&lt;br&gt;spatial reference points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFA;strokeColor=#8E63B0;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="reconstructLane">
          <mxGeometry x="35" y="80" width="300" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="parallel" value="Split input points into CPU chunks&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;shared memory lets workers use the same&lt;br&gt;coordinates and probabilities&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="reconstructLane">
          <mxGeometry x="420" y="67" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="neighbors" value="Find nearby reference points&lt;br&gt;for every input point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFA;strokeColor=#8E63B0;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="reconstructLane">
          <mxGeometry x="910" y="80" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="weight" value="Turn distances into Gaussian weights&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;nearby references influence the result more;&lt;br&gt;weights are normalized to sum to one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFA;strokeColor=#8E63B0;fontColor=#1F2937;fontSize=14;spacing=8;" vertex="1" parent="reconstructLane">
          <mxGeometry x="1330" y="62" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="blend" value="Blend neighbor class probabilities,&lt;br&gt;then choose the strongest class" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDF7;strokeColor=#8E63B0;fontColor=#1F2937;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="reconstructLane">
          <mxGeometry x="1840" y="78" width="350" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E63B0;" edge="1" parent="reconstructLane" source="tree" target="parallel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B8DEF;" edge="1" parent="reconstructLane" source="parallel" target="neighbors"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E63B0;" edge="1" parent="reconstructLane" source="neighbors" target="weight"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E63B0;" edge="1" parent="reconstructLane" source="weight" target="blend"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="output" value="Semantic labels&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;one label for every input point,&lt;br&gt;in the corresponding point order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;strokeColor=#4C9A62;fontColor=#1F2937;fontSize=16;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="945" y="1760" width="510" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="crossPrepare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="centerAll" target="grid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="crossFragment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="mapping" target="fragment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="crossMerge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6A84A;" edge="1" parent="1" source="accumulate" target="covered"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="crossReconstruct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E63B0;" edge="1" parent="1" source="references" target="tree"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="crossOutput" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4C9A62;" edge="1" parent="1" source="blend" target="output"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
